{
  "crons": [
    {
      "path": "/api/notify",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/love",
      "schedule": "0 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
